APP_NAME="Public API Discovery Engine"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- PostgreSQL (service name inside docker compose) ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=api_discovery
DB_USERNAME=api_discovery
DB_PASSWORD=secret

# --- OpenSearch ---
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_SCHEME=http
OPENSEARCH_INDEX=apis
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_SSL=false
OPENSEARCH_FUZZINESS=AUTO
SEARCH_FALLBACK_TO_DATABASE=true

# --- Redis (cache/queue, optional in phase 1) ---
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=file

# Comma separated list, or * during local development
CORS_ALLOWED_ORIGINS=*
