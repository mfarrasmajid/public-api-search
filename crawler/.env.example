# Same PostgreSQL the Laravel backend uses (crawler writes, Laravel reads).
DATABASE_URL=postgresql://api_discovery:secret@postgres:5432/api_discovery

# Crawler politeness. See docs/security-and-legal.md before raising these.
CRAWLER_USER_AGENT=PublicApiDiscoveryBot/0.1 (+https://github.com/mfarrasmajid/public-api-search)
CRAWLER_REQUESTS_PER_MINUTE=20
CRAWLER_TIMEOUT_SECONDS=15
CRAWLER_MAX_CONCURRENCY=5
CRAWLER_RESPECT_ROBOTS=true

# Health checker
HEALTHCHECK_TIMEOUT_SECONDS=10
HEALTHCHECK_BATCH_SIZE=50
