# Normalise line endings.
#
# Git for Windows defaults to core.autocrlf=true, which would check shell
# scripts out with CRLF. A CRLF entrypoint.sh fails inside the Linux
# container with "/usr/bin/env: 'bash\r': No such file or directory", so
# anything that runs in a container must stay LF.

* text=auto eol=lf

*.sh      text eol=lf
*.php     text eol=lf
*.py      text eol=lf
*.js      text eol=lf
*.jsx     text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.conf    text eol=lf
*.sql     text eol=lf
*.md      text eol=lf
Dockerfile   text eol=lf
Makefile     text eol=lf
.env.example text eol=lf

# Binary files - never touch these.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff  binary
*.woff2 binary
