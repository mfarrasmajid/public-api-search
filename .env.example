# ---------------------------------------------------------------------------
# Docker Compose environment. Copy to .env and adjust if a port is taken.
#   cp .env.example .env
# The Laravel container receives these values as environment variables, so
# backend/.env is only a fallback for running artisan outside Docker.
# ---------------------------------------------------------------------------

# --- ports on your machine -------------------------------------------------
APP_PORT=8080              # http://localhost:8080  (UI + API through nginx)
VITE_PORT=5173             # direct Vite access, for debugging
DB_PORT_HOST=5432          # psql / DBeaver
OPENSEARCH_PORT_HOST=9200  # curl / Dev Tools
REDIS_PORT_HOST=6379
DASHBOARDS_PORT=5601       # only with --profile tools

# --- application -----------------------------------------------------------
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Jakarta
CORS_ALLOWED_ORIGINS=*

# --- database --------------------------------------------------------------
DB_DATABASE=api_discovery
DB_USERNAME=api_discovery
DB_PASSWORD=secret

# --- search ----------------------------------------------------------------
OPENSEARCH_INDEX=apis
# Lower to 384m on an 8 GB machine, raise to 1g when the dataset grows.
OPENSEARCH_HEAP=512m

# --- cache/queue -----------------------------------------------------------
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# --- first boot automation (backend entrypoint) ----------------------------
AUTO_MIGRATE=true
AUTO_SEED=true
AUTO_INDEX=true

# --- crawler (profile: crawler) --------------------------------------------
CRAWLER_REQUESTS_PER_MINUTE=20
CRAWLER_RESPECT_ROBOTS=true
CRAWLER_USER_AGENT=PublicApiDiscoveryBot/0.1 (+https://github.com/mfarrasmajid/public-api-search)
